# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres (docker-compose) ---
POSTGRES_DB=forgeflow
POSTGRES_USER=forgeflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST_PORT=5433

# --- Redis (docker-compose) ---
REDIS_PASSWORD=change-me-redis
REDIS_HOST_PORT=6379

# --- MinIO (docker-compose) ---
MINIO_ROOT_USER=forgeflow
MINIO_ROOT_PASSWORD=change-me-minio

# --- Grafana (docker-compose, optional) ---
GRAFANA_ADMIN_PASSWORD=admin

# --- forgeflow-api / forgeflow-worker (Spring) ---
# Port 5433 here matches POSTGRES_HOST_PORT above since the default Postgres port is often
# already taken on a dev machine.
DB_URL=jdbc:postgresql://localhost:5433/forgeflow
DB_USER=forgeflow
DB_PASSWORD=change-me-postgres
REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

FORGEFLOW_JWT_SECRET=change-this-to-a-long-random-value-at-least-32-bytes
FORGEFLOW_JWT_EXPIRATION_MINUTES=60
FORGEFLOW_FRONTEND_ORIGIN=http://localhost:5173
FORGEFLOW_WEBHOOK_BASE_URL=http://localhost:8080
FORGEFLOW_RATE_LIMIT_ENABLED=true
FORGEFLOW_REAPER_ENABLED=true
FORGEFLOW_WEBHOOK_ENCRYPTION_KEY=change-this-passphrase-too

# MinIO has no separate "access key" concept in single-user mode: the access/secret key
# the app authenticates with ARE the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above. Keep these two
# pairs identical.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=forgeflow
MINIO_SECRET_KEY=change-me-minio
FORGEFLOW_ARTIFACT_BUCKET=forgeflow-logs

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- frontend ---
VITE_API_BASE_URL=http://localhost:8080
